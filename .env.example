# Copy this file to .env.local and add your own Supabase project values.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Optional: only use a browser-restricted Google Maps JavaScript/Places key if enabling Places directly.
# For production, prefer a server-side/Edge Function proxy and restrict the key by API + allowed origins.
VITE_GOOGLE_MAPS_API_KEY=
